{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "agents/cicd-pipeline/output.schema.json",
 "title": "CicdPipeline",
 "description": "Salida de cicd-pipeline-agent (Tabla 18). El agente define jobs, pasos y puertas por ambiente; core/render.py lo serializa de forma determinista a workflows YAML de GitHub Actions, que se validan en F5.",
 "type": "object",
 "required": [
  "req_id",
  "pipelines",
  "promocion",
  "provenance"
 ],
 "properties": {
  "req_id": {
   "type": "string"
  },
  "pipelines": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "ambiente",
     "disparador",
     "jobs",
     "gates"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^PIPE-[0-9]{3}$"
     },
     "ambiente": {
      "type": "string",
      "enum": [
       "dev",
       "staging",
       "prod"
      ]
     },
     "disparador": {
      "type": "string",
      "enum": [
       "push",
       "pull_request",
       "workflow_dispatch",
       "tag"
      ]
     },
     "jobs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "runs_on",
        "needs",
        "steps"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_-]{1,30}$"
        },
        "runs_on": {
         "type": "string",
         "enum": [
          "ubuntu-latest",
          "ubuntu-24.04"
         ]
        },
        "needs": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,30}$"
         },
         "maxItems": 4
        },
        "environment": {
         "type": "string",
         "enum": [
          "dev",
          "staging",
          "prod"
         ]
        },
        "steps": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "nombre"
          ],
          "properties": {
           "nombre": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
           },
           "uses": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9._-]+@v[0-9]+$"
           },
           "run": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
           }
          },
          "additionalProperties": false
         },
         "minItems": 1,
         "maxItems": 10
        }
       },
       "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6
     },
     "gates": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "etapa",
        "tipo",
        "criterio"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^GATE-[0-9]{3}$"
        },
        "etapa": {
         "type": "string",
         "enum": [
          "build",
          "test",
          "security",
          "deploy"
         ]
        },
        "tipo": {
         "type": "string",
         "enum": [
          "automatica",
          "manual"
         ]
        },
        "criterio": {
         "type": "string",
         "minLength": 5,
         "maxLength": 200
        }
       },
       "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6
     }
    },
    "additionalProperties": false
   },
   "minItems": 1,
   "maxItems": 3
  },
  "promocion": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "desde",
     "hacia",
     "criterio"
    ],
    "properties": {
     "desde": {
      "type": "string",
      "enum": [
       "dev",
       "staging"
      ]
     },
     "hacia": {
      "type": "string",
      "enum": [
       "staging",
       "prod"
      ]
     },
     "criterio": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
     }
    },
    "additionalProperties": false
   },
   "maxItems": 2
  },
  "provenance": {
   "$ref": "../../contracts/provenance.schema.json"
  }
 },
 "additionalProperties": false
}
