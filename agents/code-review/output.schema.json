{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "agents/code-review/output.schema.json",
 "title": "CodeReview",
 "description": "Salida de code-review-agent (Tabla 17): hallazgos FIND-xxx sobre el código generado, a partir del análisis estático real (ruff, bandit) y de la revisión del modelo.",
 "type": "object",
 "required": [
  "req_id",
  "hallazgos",
  "veredicto",
  "provenance"
 ],
 "properties": {
  "req_id": {
   "type": "string"
  },
  "hallazgos": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "severidad",
     "archivo",
     "linea",
     "regla",
     "descripcion",
     "recomendacion"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^FIND-[0-9]{3}$"
     },
     "severidad": {
      "type": "string",
      "enum": [
       "critico",
       "mayor",
       "menor"
      ]
     },
     "archivo": {
      "type": "string",
      "pattern": "^app/[a-z_]+\\.py$"
     },
     "linea": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
     },
     "regla": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
     },
     "descripcion": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
     },
     "recomendacion": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
     }
    },
    "additionalProperties": false
   },
   "maxItems": 15
  },
  "veredicto": {
   "type": "string",
   "enum": [
    "aprobado",
    "cambios_requeridos"
   ]
  },
  "provenance": {
   "$ref": "../../contracts/provenance.schema.json"
  }
 },
 "additionalProperties": false
}
