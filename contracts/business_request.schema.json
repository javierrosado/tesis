{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/business_request.schema.json",
  "title": "BusinessRequest",
  "description": "Entrada del pipeline: solicitud de negocio normalizada (brief + restricciones). Contrato v1.0, congelado al cierre de la Fase 1.",
  "type": "object",
  "required": ["req_id", "proyecto", "titulo", "necesidad", "resultado_esperado", "restricciones", "reglas_negocio", "preguntas_abiertas", "puntos_historia", "contract_version"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "req_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z0-9]+-R[0-9]{3}$"},
    "proyecto": {"type": "string"},
    "titulo": {"type": "string", "minLength": 5},
    "tipo": {"type": "string", "enum": ["Funcional", "No funcional", "Técnico", "Regulatorio"]},
    "origen": {"type": "string"},
    "solicitante": {"type": "string"},
    "campana": {"type": "string"},
    "necesidad": {"type": "string", "minLength": 20},
    "resultado_esperado": {"type": "string", "minLength": 20},
    "restricciones": {"type": "array", "items": {"type": "string"}},
    "reglas_negocio": {"type": "array", "items": {"type": "string", "pattern": "^BR-[0-9]{3}"}},
    "preguntas_abiertas": {"type": "array", "items": {"type": "string"}},
    "puntos_historia": {"type": "integer", "minimum": 1, "maximum": 13},
    "datos_personales": {"type": "boolean"},
    "fecha_release_comprometida": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
